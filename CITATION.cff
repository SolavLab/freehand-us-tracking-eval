    given-names: Dana
    orcid: "https://orcid.org/0000-0003-3215-0401"
    affiliation: "Faculty of Mechanical Engineering, Technion - Israel Institute of Technology"
keywords:
  - freehand 3D ultrasound
  - hand-eye calibration
  - motion capture
  - probe tracking
  - SLAM
  - visual-inertial odometry
