diff --git a/docker/Dockerfile.realsense b/docker/Dockerfile.realsense
index 2c91710..9c8a5f7 100644
--- a/docker/Dockerfile.realsense
+++ b/docker/Dockerfile.realsense
@@ -15,6 +15,21 @@ ARG LIBREALSENSE_SOURCE_VERSION=v2.55.1
 ARG REALSENSE_ROS_GIT_URL=https://github.com/NVIDIA-ISAAC-ROS/realsense-ros.git
 ARG REALSENSE_ROS_VERSION=release/4.51.1-isaac
 
+# --- Isaac ROS APT repo (release-3.0) and keyring  <<<< this block from chatgpt to sort apt and apt-get issues---
+ENV DEBIAN_FRONTEND=noninteractive
+RUN set -eux; \
+    mkdir -p /usr/share/keyrings; \
+    curl -fsSL https://isaac.download.nvidia.com/isaac-ros/repos.key \
+      | gpg --dearmor -o /usr/share/keyrings/nvidia-isaac-ros.gpg; \
+    echo "deb [signed-by=/usr/share/keyrings/nvidia-isaac-ros.gpg] https://isaac.download.nvidia.com/isaac-ros/release-3 jammy release-3.0" \
+      > /etc/apt/sources.list.d/nvidia-isaac-ros.list; \
+    sed -i '/isaac-ros/d' /etc/apt/sources.list || true; \
+    # Allow repo Release-info changes (Origin/Label/Suite) non-interactively
+    printf 'Acquire::AllowReleaseInfoChange::Origin "true";\nAcquire::AllowReleaseInfoChange::Label "true";\nAcquire::AllowReleaseInfoChange::Suite "true";\n' \
+      > /etc/apt/apt.conf.d/allow-releaseinfo-change; \
+    apt-get -o Acquire::Retries=5 update
+
+
 COPY scripts/build-librealsense.sh /opt/realsense/build-librealsense.sh
 COPY scripts/install-realsense-dependencies.sh /opt/realsense/install-realsense-dependencies.sh
 
